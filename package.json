{
  "name": "@warpgogol/repo-extract",
  "version": "1.2.6",
  "description": "Extract apps and packages from a TurboRepo monorepo into standalone public repositories",
  "license": "Apache-2.0",
  "author": "Andrii Syrokomskyi <andrii@syrokomskyi.com> (https://syrokomskyi.com)",
  "homepage": "https://github.com/syrokomskyi/repo-extract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrokomskyi/repo-extract.git"
  },
  "bugs": {
    "url": "https://github.com/syrokomskyi/repo-extract/issues"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "extract",
    "export",
    "standalone",
    "publish",
    "automation"
  ],
  "type": "module",
  "bin": {
    "repo-extract": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init",
    "prepublishOnly": "pnpm run build",
    "upgrade-packages": "pnpm up --latest"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "tslib": "^2.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@warpgogol/changelog-live": "*"
  },
  "peerDependenciesMeta": {
    "@warpgogol/changelog-live": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "~10.8.0",
    "tsx": "^4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
