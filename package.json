{
  "name": "@warpgogol/repo-extract",
  "version": "0.1.0",
  "description": "Extract apps and packages from a TurboRepo monorepo into standalone public repositories",
  "license": "Apache-2.0",
  "author": "Andrii Syrokomskyi <andrii@syrokomskyi.com> (https://syrokomskyi.com)",
  "homepage": "https://github.com/syrokomskyi/repo-extract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrokomskyi/repo-extract.git"
  },
  "bugs": {
    "url": "https://github.com/syrokomskyi/repo-extract/issues"
  },
  "keywords": ["monorepo", "turborepo", "extract", "export", "standalone", "publish", "automation"],
  "type": "module",
  "bin": {
    "repo-extract": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "!**/*.tsbuildinfo"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@warpgogol/changelog-live": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@warpgogol/changelog-live": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@warpgogol/changelog-live": "workspace:*",
    "tsx": "^4.23.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
